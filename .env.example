# ESG Analysis Platform Environment Configuration
# Copy this file to .env and update with your actual values

# LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEFAULT_MODEL=gpt-4o-mini
TEMPERATURE=0.1
MAX_TOKENS=4000

# Vector Database Configuration (Using Qdrant)
VECTOR_STORE_TYPE=QDRANT
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=esg_documents

# Embedding Configuration
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Document Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_FILE_SIZE=10485760
SUPPORTED_EXTENSIONS=.pdf,.docx,.txt,.md,.csv,.xlsx

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=esg_analysis
POSTGRES_USER=esg_user
POSTGRES_PASSWORD=esg_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# RAG Configuration
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.7
MAX_CONTEXT_LENGTH=4000
ENABLE_QUERY_DECOMPOSITION=true
ENABLE_HYBRID_SEARCH=true
ENABLE_RERANKING=false

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Monitoring
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=esg-analysis
ENABLE_MONITORING=false

# Streamlit UI Configuration
STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501
ESG_API_URL=http://localhost:8000

# Production Settings
DEBUG=true
LOG_LEVEL=INFO
WORKERS=4
RELOAD=true

# ESG Framework Configuration
ESG_FRAMEWORKS=CSRD,GRI,SASB,TCFD,EU_Taxonomy,SEC_Climate
ESG_CATEGORIES=Environmental,Social,Governance