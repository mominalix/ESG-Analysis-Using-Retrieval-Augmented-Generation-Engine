# Application
ENVIRONMENT=development
DEBUG=false
DOCS_ENABLED=true
HOST=0.0.0.0
PORT=8000
WORKERS=1
RELOAD=false
LOG_LEVEL=INFO
LOG_FORMAT=console

# Security — generate a unique value before enabling admin report endpoints
ADMIN_TOKEN=
SECRET_KEY=
ALLOWED_ORIGINS=http://localhost:8501
CORS_ALLOW_CREDENTIALS=false
TRUSTED_HOSTS=

# Language models — configure one or both
DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_USE_RESPONSES_API=true
OPENAI_REASONING_EFFORT=low
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
TEMPERATURE=0.1
# Leave blank for provider/model defaults; overly small limits can starve reasoning output
MAX_OUTPUT_TOKENS=

# Retrieval — memory works without external infrastructure or embedding credentials
VECTOR_STORE_TYPE=memory
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=esg_documents
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=esg_documents
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Document processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CHUNKS_PER_DOCUMENT=500
MAX_FILE_SIZE=10485760
SUPPORTED_EXTENSIONS=.pdf,.docx,.txt,.md,.csv,.xlsx
TAXONOMY_PATH=./config/esg_taxonomy.json

# RAG
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.0
MAX_CONTEXT_LENGTH=12000
ENABLE_QUERY_DECOMPOSITION=true
ENABLE_HYBRID_SEARCH=true
ENABLE_RERANKING=false

# Optional LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=esg-analysis
LANGSMITH_TRACING_V2=false

# Streamlit API client
ESG_API_URL=http://localhost:8000
API_CONNECT_TIMEOUT_SECONDS=5
API_READ_TIMEOUT_SECONDS=120
API_RETRY_COUNT=2
